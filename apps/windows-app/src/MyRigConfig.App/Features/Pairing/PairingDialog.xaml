<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MyRigConfig.Features.Pairing.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyRigConfig.Features.Pairing"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    AutomationProperties.AutomationId="PairingDialog"
    CloseButtonText="{x:Bind ViewModel.CloseText, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="340" Spacing="12">
        <!--  Name the device  -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsNameStep, Mode=OneWay}">
            <TextBox
                x:Name="NameBox"
                AutomationProperties.AutomationId="PairDeviceName"
                Header="{x:Bind local:PairingMessages.DeviceNameLabel, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  Show the code  -->
        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsCodeStep, Mode=OneWay}">
            <Border
                Padding="16,20"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="PairingCode"
                    AutomationProperties.Name="{x:Bind ViewModel.CodeAccessibleName, Mode=OneWay}"
                    CharacterSpacing="160"
                    FontFamily="Cascadia Mono, Consolas"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.CodeText, Mode=OneWay}" />
            </Border>
            <StackPanel Spacing="8">
                <ProgressBar
                    AutomationProperties.AutomationId="PairingLifetime"
                    AutomationProperties.Name="{x:Bind local:PairingMessages.CodeTimeLabel, Mode=OneTime}"
                    Maximum="100"
                    Value="{x:Bind ViewModel.RemainingPercent, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="PairingCountdown"
                    AutomationProperties.LiveSetting="Off"
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!--  Errors  -->
        <InfoBar
            AutomationProperties.AutomationId="PairingError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="PageContentMaxWidth">760</x:Double>
    <Thickness x:Key="PageContentPadding">36,8,36,36</Thickness>
    <Thickness x:Key="FirstSectionHeaderMargin">1,8,0,4</Thickness>
    <!--  Windows Settings spacing between cards in a group  -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <Style x:Key="SectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="1,24,0,4" />
    </Style>

    <Style x:Key="SecondaryTextBlockStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>

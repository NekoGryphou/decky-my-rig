<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The app restores this project for win-x64; declaring it keeps one lock
         file valid for both the app and the test restores. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- ! Integration tests read the real machine TCP tables; they run only when asked for
         (dotnet test, filter TestCategory=Integration). -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
    <VSTestTestCaseFilter>TestCategory!=Integration</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <!-- The view-model layer of the app compiles into the tests as it is; only files that need the
       WinUI runtime stay out: XAML code-behind, App.xaml.cs, custom controls, the shell. -->
  <PropertyGroup>
    <AppSource>../../src/MyRigConfig.App</AppSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AppSource)/**/*.cs" Link="App/%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="$(AppSource)/obj/**;$(AppSource)/bin/**;$(AppSource)/App.xaml.cs;$(AppSource)/**/*.xaml.cs;$(AppSource)/Shell/Program.cs;$(AppSource)/Shell/ProgramNative.cs;$(AppSource)/Shell/MainWindowNative.cs;$(AppSource)/Features/Host/InvokableSettingsCard*.cs;$(AppSource)/Features/Host/HostPageHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MyRigConfig.Core/MyRigConfig.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <None Include="../../../../tests/fixtures/local-control/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

    <Compile Include="../../src/MyRigConfig.App/Features/Host/HostViewModel.Settings.cs" Link="ViewModels/HostViewModel.Settings.cs" />
    <Compile Include="../../src/MyRigConfig.App/Features/Host/HostMessages.cs" Link="ViewModels/HostMessages.cs" />
    <Compile Include="../../src/MyRigConfig.App/Features/Host/HostTypes.cs" Link="ViewModels/HostTypes.cs" />
    <Compile Include="../../src/MyRigConfig.App/Features/Host/HostHelpers.cs" Link="ViewModels/HostHelpers.cs" />
